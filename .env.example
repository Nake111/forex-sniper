# Optional Twelve Data reference feed. Obtain your own API key and store it as a secret.
TWELVE_DATA_API_KEY=
# Confirm symbol availability on your Twelve Data plan before enabling DXY.
GOLD_LIVE_SYMBOLS=XAU/USD,DXY
GOLD_LIVE_DATA_DIR=data

# Historical candle downloader
DATA_DAYS_BACK=180

# BTC spot reference source: "kraken-btcusd" selects Kraken XBT/USD; "btcusd" uses Dukascopy.
BTC_DATA_PREFIX=kraken-btcusd
