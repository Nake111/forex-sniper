//@version=6
indicator("Forex Sniper Chart Data Bridge", overlay=true)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(14)
plot(ema20, "EMA 20", color=color.teal)
plot(ema50, "EMA 50", color=color.orange)
bull = ema20 > ema50 and close > ema20 and rsi14 >= 52
bear = ema20 < ema50 and close < ema20 and rsi14 <= 48
direction = bull ? "BUY" : bear ? "SELL" : "HOLD"
if barstate.isconfirmed
    payload = "{"
    payload += "\"source\":\"TradingView\","
    payload += "\"ticker\":\"" + syminfo.tickerid + "\","
    payload += "\"timeframe\":\"" + timeframe.period + "\","
    payload += "\"timeframe_minutes\":" + str.tostring(timeframe.in_seconds() / 60) + ","
    payload += "\"bar_time\":" + str.tostring(time) + ","
    payload += "\"open\":" + str.tostring(open, format.mintick) + ","
    payload += "\"high\":" + str.tostring(high, format.mintick) + ","
    payload += "\"low\":" + str.tostring(low, format.mintick) + ","
    payload += "\"close\":" + str.tostring(close, format.mintick) + ","
    payload += "\"volume\":" + str.tostring(volume) + ","
    payload += "\"ema20\":" + str.tostring(ema20, format.mintick) + ","
    payload += "\"ema50\":" + str.tostring(ema50, format.mintick) + ","
    payload += "\"rsi14\":" + str.tostring(rsi14, "#.##") + ","
    payload += "\"atr14\":" + str.tostring(atr14, format.mintick) + ","
    payload += "\"action\":\"" + direction + "\"}"
    alert(payload, alert.freq_once_per_bar_close)
