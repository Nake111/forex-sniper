import test from "node:test";
import assert from "node:assert/strict";

import {
  calculateIndicators,
  generateSignal,
} from "../src/signal.js";

test("calculateIndicators returns indicator values", () => {
  const candles = [];

  for (let i = 0; i < 100; i++) {
    const close = 60000 + i * 20;

    candles.push({
      time: 1700000000 + i * 300,
      open: close - 10,
      high: close + 30,
      low: close - 30,
      close,
      volume: 10,
    });
  }

  const result = calculateIndicators(candles);

  assert.ok(result);
  assert.ok(Number.isFinite(result.ema20));
  assert.ok(Number.isFinite(result.ema50));
  assert.ok(Number.isFinite(result.rsi14));
  assert.ok(Number.isFinite(result.atr14));
});

test("signal output is a valid trading decision", () => {
  const candles = [];

  for (let i = 0; i < 200; i++) {
    const close = 60000 + Math.sin(i / 5) * 100 + i * 2;

    candles.push({
      time: 1700000000 + i * 300,
      open: close - 5,
      high: close + 25,
      low: close - 25,
      close,
      volume: 100 + i,
    });
  }

  const result = generateSignal(candles);

  assert.ok(result);
  assert.ok(["BUY", "SELL", "HOLD"].includes(result.signal));
});
